generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  birthdate     DateTime
  emailVerified Boolean   @default(false)
  estatus       String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @default(now()) @updatedAt()
  rol           String    @default("paciente")
  order         Order[]
}

model Users {
  id Int @id @default(autoincrement())
  nombres String
  cedula  String
  password String
  telefono String
  email String
  direccion String
  rol String @default("paciente")
  isFirstLogin Boolean
  studies Studies []
}

model Studies {
  id Int @id @default(autoincrement())
  fecha DateTime 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime @default(now()) @updatedAt()
  description String
  laboratorio Boolean
  pdf String
  url String
  userId Int
  studies Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  
}

model Perfil {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  bio       String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt()
}

model Order {
  id          Int       @id @default(autoincrement())
  description String
  valor       Float
  authorId    Int
  autor       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @default(now()) @updatedAt()
}

model Characters {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  status    String
  species   String
  type      String?
  gender    String
  image     String
  createdAt DateTime?  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt()
}
