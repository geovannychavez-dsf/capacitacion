generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  birthdate     DateTime
  emailVerified Boolean   @default(false)
  estatus       String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @default(now()) @updatedAt()
  order         Order[]
}

model Perfil {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  bio       String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt()
}

model Order {
  id          Int       @id @default(autoincrement())
  description String
  valor       Float
  authorId    Int
  autor       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @default(now()) @updatedAt()
}

model Characters {
  id         Int        @id @default(autoincrement())
  name       String  @unique
  status     String
  species    String
  type       String?
  gender     String
  image      String
  }
