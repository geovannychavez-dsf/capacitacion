generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  birthdate     DateTime
  emailVerified Boolean   @default(false)
  estatus       String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @default(now()) @updatedAt()
  rol           String    @default("paciente")
  order         Order[]
  refreshToken  RefreshTokens[]
}

model Users {
  id Int @id @default(autoincrement())
  nombres String
  cedula  String
  password String
  telefono String
  email String
  direccion String
  rol String @default("paciente")
  isFirstLogin Boolean
}

model RefreshTokens {
  id        Int       @id @default(autoincrement())
  tokenHash String
  userId    Int
  expiresAt DateTime
  revoked   Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt()

}

model Perfil {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  bio       String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt()
}

model Order {
  id          Int       @id @default(autoincrement())
  description String
  valor       Float
  authorId    Int
  autor       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @default(now()) @updatedAt()
}

model Characters {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  status    String
  species   String
  type      String?
  gender    String
  image     String
  createdAt DateTime?  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt()
}
